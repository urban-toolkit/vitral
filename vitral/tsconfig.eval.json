{
  /* The evaluation harness: node scripts that drive the real pipeline and write raw results.
     Separate from `tsconfig.app.json` because these use node globals, which the test files under
     `src` deliberately avoid so they can share the app's config. Both libs are present because the
     scripts run under node but import modules written against DOM types -- `File`, `Blob`, `fetch`
     and `FormData` all exist in node 20, which is what makes driving the client path headlessly
     possible at all. */
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.eval.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["node", "vite/client"],
    "skipLibCheck": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    /* `config/types.tsx` is reached transitively through `LLMRequest`; the extension forces this. */
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["eval"]
}
